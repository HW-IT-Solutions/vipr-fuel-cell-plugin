# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Test and coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging output
*.egg-info/
build/
dist/

# VIPR runtime output
storage/
results/
logs/
*.log

# Local measurement and model artifacts
/data/
/checkpoints/
*.mat
*.h5
*.hdf5
*.ckpt
*.pt
*.pth

# Only the documented operating-state model bundle is versioned. Its checkpoint
# is stored through Git LFS; the small scaler files remain regular Git objects.
/models/*
!/models/README.md
!/models/checksums.sha256
!/models/operating_state_reconstruction/
/models/operating_state_reconstruction/*
!/models/operating_state_reconstruction/checkpoint.ckpt
!/models/operating_state_reconstruction/scaler_x.json
!/models/operating_state_reconstruction/scaler_y.json

# Celery runtime files
celerybeat-schedule*
celerybeat.pid

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
